# Environment for the Rails API. Rails doesn't load this file itself:
# export the variables in your shell or set them on your host.

# PostgreSQL connection (overrides config/database.yml when set).
# DATABASE_URL=postgres://user:password@localhost:5432/salary_management_development

# Business time zone: decides what "today" is, and so whether a salary
# period is past, current or pending.
APP_TIME_ZONE=Asia/Kolkata

# Comma-separated origins allowed to call /api/* (the React app).
CORS_ORIGINS=http://localhost:5173

# Production only: decrypts config/credentials.yml.enc.
# RAILS_MASTER_KEY=
