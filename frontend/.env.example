# Copy to .env.local and adjust. Every variable is optional; the defaults
# below are used when a variable is unset.

# Base URL of the Rails API (without /api/v1).
VITE_API_BASE_URL=http://localhost:3000

# Product name shown in the header and browser tab.
VITE_APP_NAME=ACME Salary

# The demo HR user shown in the header. There is no authentication.
VITE_HR_USER_NAME=Jordan Rivera
VITE_HR_USER_ROLE=HR Manager
